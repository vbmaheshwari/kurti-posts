{
  "name": "Kurti Post Maker",
  "short_name": "Kurti Posts",
  "description": "Turns supplier catalogues from WhatsApp into buyer posts.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F6FB",
  "theme_color": "#2D3E9C",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*", "application/zip", "application/x-zip-compressed", ".zip", "text/plain", ".txt"]
        }
      ]
    }
  }
}
